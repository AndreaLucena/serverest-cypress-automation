# Dependencias instaladas, cache e logs locais
node_modules/
.npm/
.cache/
*.log

# Artefatos gerados pelo Cypress (versionar apenas os .gitkeep)
/cypress/reports/*
!/cypress/reports/.gitkeep
/cypress/screenshots/*
!/cypress/screenshots/.gitkeep
/cypress/videos/*
!/cypress/videos/.gitkeep
/cypress/downloads/*
!/cypress/downloads/.gitkeep

# Configuracoes locais e segredos
.env
.env.*
!.env.example
/cypress.env.json

# Metadados do sistema operacional
Thumbs.db
Desktop.ini
.DS_Store
