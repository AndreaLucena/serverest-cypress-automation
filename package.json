{
  "name": "cypress-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Projeto de automação de testes com Cypress e Cucumber",
  "scripts": {
    "cy:open": "node ./node_modules/cypress/bin/cypress open",
    "cy:run": "node ./node_modules/cypress/bin/cypress run",
    "cy:run:api": "node ./node_modules/cypress/bin/cypress run --spec \"cypress/e2e/features/api/**/*.feature\"",
    "serverest:local": "serverest --nodoc",
    "report": "node generate-report.js"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^28.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "cypress": "^16.3.0",
    "esbuild": "0.27.2",
    "multiple-cucumber-html-reporter": "^4.6.0",
    "serverest": "3.5.0"
  },
  "overrides": {
    "glob": "14.0.6",
    "minimatch": "11.0.9"
  },
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": "cypress/e2e/step_definitions/**/*.js",
    "json": {
      "enabled": true,
      "output": "cypress/reports/cucumber-report.json"
    }
  },
  "allowScripts": {
    "cypress@16.3.0": true,
    "esbuild@0.27.2": true
  },
  "main": "cypress.config.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndreaLucena/serverest-cypress-automation.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/AndreaLucena/serverest-cypress-automation/issues"
  },
  "homepage": "https://github.com/AndreaLucena/serverest-cypress-automation#readme"
}
